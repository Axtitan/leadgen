  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lemon pill for the one next action per region (Find leads, the lead's main contact button).",
      "html": "<button class='ds-btn-lemon'><svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><path d='m20 20-3.5-3.5'/></svg>Find leads</button>",
      "css": ".ds-btn-lemon{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 18px;border-radius:999px;border:1px solid transparent;background:var(--lemon,#EDE65A);color:var(--lemon-ink,#1F1E0A);font-size:14px;font-weight:500;cursor:pointer;transition:background-color .15s,transform .12s cubic-bezier(.16,1,.3,1)}.ds-btn-lemon:hover{background:var(--lemon-hi,#E4DC3E)}.ds-btn-lemon:active{transform:scale(.97)}.ds-btn-lemon:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Tile-coloured pill with a hairline border for secondary actions (Call, Export, Filters).",
      "html": "<button class='ds-btn-quiet'><svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3v12m0 0-4-4m4 4 4-4M5 21h14'/></svg>Export CSV</button>",
      "css": ".ds-btn-quiet{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 18px;border-radius:999px;border:1px solid var(--line,#E3E3DB);background:var(--tile,#FFFFFF);color:var(--ink,#1A1B1D);font-size:14px;font-weight:500;cursor:pointer;transition:background-color .15s,border-color .15s,transform .12s cubic-bezier(.16,1,.3,1)}.ds-btn-quiet:hover{background:var(--tile-2,#F6F6F1);border-color:var(--line-2,#D3D3CA)}.ds-btn-quiet:active{transform:scale(.97)}.ds-btn-quiet:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:2px}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "40px circle with a hairline border and an 18px stroke icon.",
      "html": "<button class='ds-iconbtn' aria-label='Switch to dark mode'><svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z'/></svg></button>",
      "css": ".ds-iconbtn{display:inline-grid;place-items:center;width:40px;height:40px;border-radius:50%;border:1px solid var(--line,#E3E3DB);background:var(--tile,#FFFFFF);color:var(--ink,#1A1B1D);cursor:pointer;transition:background-color .15s,border-color .15s,transform .12s cubic-bezier(.16,1,.3,1)}.ds-iconbtn:hover{background:var(--tile-2,#F6F6F1);border-color:var(--line-2,#D3D3CA)}.ds-iconbtn:active{transform:scale(.94)}.ds-iconbtn:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Pill field with a leading icon; focus turns the border ink.",
      "html": "<label class='ds-search'><svg width='17' height='17' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><path d='m20 20-3.5-3.5'/></svg><input type='search' placeholder='Search name, street, phone, notes'></label>",
      "css": ".ds-search{position:relative;display:block;max-width:420px}.ds-search svg{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:var(--mut,#6A6B66)}.ds-search input{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;width:100%;height:42px;padding:0 16px 0 42px;border-radius:999px;border:1px solid var(--line,#E3E3DB);background:var(--tile,#FFFFFF);color:var(--ink,#1A1B1D);font-size:14px;transition:border-color .15s}.ds-search input:hover{border-color:var(--line-2,#D3D3CA)}.ds-search input:focus{outline:none;border-color:var(--ink,#1A1B1D)}.ds-search input:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:1px}.ds-search input::placeholder{color:var(--mut,#6A6B66)}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill chips; the selected chip is inverted ink, never lemon.",
      "html": "<div class='ds-chips'><button class='ds-chip' aria-pressed='true'>Electricians</button><button class='ds-chip' aria-pressed='false'>Roofers</button><button class='ds-chip' aria-pressed='false'>Barbers</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px}.ds-chip{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;height:34px;padding:0 14px;border-radius:999px;border:1px solid var(--line,#E3E3DB);background:var(--tile,#FFFFFF);color:var(--ink,#1A1B1D);font-size:13px;font-weight:500;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-chip:hover{border-color:var(--line-2,#D3D3CA)}.ds-chip[aria-pressed='true']{background:var(--sel,#1F2023);border-color:var(--sel,#1F2023);color:var(--sel-ink,#F4F4EF)}.ds-chip:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:2px}"
    },
    {
      "name": "Website Status Pills",
      "kind": "custom",
      "refersTo": "status-pill",
      "description": "Dot + word on a tinted fill; an unverified 'No website listed' adds a diagonal hatch and a hollow dot.",
      "html": "<div class='ds-pills'><span class='ds-pill ds-p-broken'>Domain expired</span><span class='ds-pill ds-p-none'>No website</span><span class='ds-pill ds-p-none ds-unv'>No website listed</span><span class='ds-pill ds-p-ok'>Good website</span></div>",
      "css": ".ds-pills{display:flex;flex-wrap:wrap;gap:6px}.ds-pill{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 11px 0 9px;border-radius:999px;font-size:12.5px;font-weight:500;white-space:nowrap;color:var(--c);background:var(--cb)}.ds-pill::before{content:'';box-sizing:border-box;width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}.ds-p-broken{--c:var(--p-broken,#B42318);--cb:var(--p-broken-bg,#FDECEA)}.ds-p-none{--c:var(--p-none,#8F5300);--cb:var(--p-none-bg,#FBEFD6)}.ds-p-ok{--c:var(--p-ok,#157339);--cb:var(--p-ok-bg,#E3F4E8)}.ds-unv{background:repeating-linear-gradient(135deg,color-mix(in srgb,var(--c) 16%,transparent) 0 1.5px,transparent 1.5px 6px),var(--cb)}.ds-unv::before{background:none;border:1.5px solid currentColor}"
    },
    {
      "name": "Strength Meter",
      "kind": "custom",
      "refersTo": "status-pill",
      "description": "Five rising ink bars: bars only on cards; with the word (and Lemon Wash at 'Very strong') in the open lead's header.",
      "html": "<div class='ds-strrow'><span class='ds-str ds-bars ds-s4' role='img' aria-label='Lead strength: strong'><i></i><i></i><i></i><i></i><i></i></span><span class='ds-str ds-s5' role='img' aria-label='Lead strength: very strong'><i></i><i></i><i></i><i></i><i></i><b>Very strong</b></span></div>",
      "css": ".ds-strrow{display:flex;gap:8px;align-items:center}.ds-str{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:2px;height:26px;padding:0 10px 0 9px;border-radius:999px;background:var(--tile-2,#F6F6F1);color:var(--ink,#1A1B1D);font-size:12px;font-weight:600}.ds-str i{width:3px;border-radius:2px;background:var(--line-2,#D3D3CA)}.ds-str i:nth-child(1){height:5px}.ds-str i:nth-child(2){height:7px}.ds-str i:nth-child(3){height:9px}.ds-str i:nth-child(4){height:11px}.ds-str i:nth-child(5){height:13px}.ds-str b{margin-left:6px}.ds-s4 i:nth-child(-n+4),.ds-s5 i{background:var(--ink,#1A1B1D)}.ds-s5{background:var(--lemon-soft,#F8F4BE)}.ds-bars{padding:0 9px;background:transparent;border:1px solid var(--line,#E3E3DB)}"
    },
    {
      "name": "Lead Card",
      "kind": "card",
      "refersTo": "lead-card",
      "description": "A sparse 22px card: name, ink strength bars, one status pill, Google button. Lifts on hover.",
      "html": "<article class='ds-card'><div class='ds-c-row'><h3>A Class Electrical</h3><span class='ds-cstr'><i></i><i></i><i></i><i></i><i></i></span></div><div class='ds-c-row'><span class='ds-cpill'>No website</span><a href='#' class='ds-gpill'>Google</a></div></article>",
      "css": ".ds-card{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:flex;flex-direction:column;gap:10px;width:300px;padding:18px 18px 14px 20px;border-radius:22px;background:var(--tile,#FFFFFF);border:1px solid var(--line,#E3E3DB);color:var(--ink,#1A1B1D);transition:border-color .15s,box-shadow .2s cubic-bezier(.16,1,.3,1)}.ds-card:hover{border-color:var(--line-2,#D3D3CA);box-shadow:var(--shadow,0 1px 2px rgb(30 30 20 / .04),0 10px 28px -14px rgb(30 30 20 / .16))}.ds-c-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-card h3{margin:0;font-size:16.5px;font-weight:600;letter-spacing:-.01em;line-height:1.3}.ds-cstr{display:inline-flex;align-items:center;gap:2px;height:26px;padding:0 9px;border-radius:999px;border:1px solid var(--line,#E3E3DB)}.ds-cstr i{width:3px;border-radius:2px;background:var(--ink,#1A1B1D)}.ds-cstr i:nth-child(1){height:5px}.ds-cstr i:nth-child(2){height:7px}.ds-cstr i:nth-child(3){height:9px}.ds-cstr i:nth-child(4){height:11px}.ds-cstr i:nth-child(5){height:13px}.ds-cpill{display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 11px 0 9px;border-radius:999px;font-size:12.5px;font-weight:500;color:var(--p-none,#8F5300);background:var(--p-none-bg,#FBEFD6)}.ds-cpill::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor}.ds-gpill{display:inline-flex;align-items:center;height:30px;padding:0 12px;border-radius:999px;border:1px solid var(--line,#E3E3DB);background:var(--tile,#FFFFFF);color:var(--ink,#1A1B1D);font-size:12.5px;font-weight:500;text-decoration:none;transition:background-color .15s}.ds-gpill:hover{background:var(--tile-2,#F6F6F1)}.ds-gpill:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:2px}"
    },
    {
      "name": "Side Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Pill links in a 28px rail tile; the active link is lemon, counts are tabular.",
      "html": "<nav class='ds-rail'><a href='#'>Next up<b>1,578</b></a><a href='#' aria-current='page'>All leads<b>1,799</b></a><a href='#'>Follow-ups</a><a href='#'>Searches</a></nav>",
      "css": ".ds-rail{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:grid;gap:4px;width:228px;padding:14px;border-radius:28px;background:var(--tile,#FFFFFF);border:1px solid var(--line,#E3E3DB)}.ds-rail a{display:flex;align-items:center;gap:12px;height:44px;padding:0 12px 0 14px;border-radius:999px;color:var(--ink,#1A1B1D);text-decoration:none;font-size:14px;font-weight:500;transition:background-color .15s}.ds-rail a b{margin-left:auto;font-size:12px;font-weight:600;color:var(--mut,#6A6B66);font-variant-numeric:tabular-nums}.ds-rail a:hover:not([aria-current]){background:var(--tile-2,#F6F6F1)}.ds-rail a[aria-current='page']{background:var(--lemon,#EDE65A);color:var(--lemon-ink,#1F1E0A)}.ds-rail a[aria-current='page'] b{color:var(--lemon-ink,#1F1E0A);opacity:.75}.ds-rail a:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:2px}"
    },
    {
      "name": "Stat Tile",
      "kind": "card",
      "refersTo": "stat-tile",
      "description": "Pipeline count tile that filters the board; inverts to ink when pressed.",
      "html": "<div class='ds-stats'><button class='ds-stat' aria-pressed='true'><small>New</small><b>1,204</b></button><button class='ds-stat' aria-pressed='false'><small>Contacted</small><b>312</b></button></div>",
      "css": ".ds-stats{display:flex;gap:10px}.ds-stat{font-family:'Host Grotesk',ui-sans-serif,system-ui,sans-serif;display:grid;text-align:left;min-width:150px;padding:14px 16px;border-radius:22px;background:var(--tile,#FFFFFF);border:1px solid var(--line,#E3E3DB);color:var(--ink,#1A1B1D);cursor:pointer;transition:border-color .15s,background-color .15s,color .15s}.ds-stat:hover{border-color:var(--line-2,#D3D3CA)}.ds-stat small{font-size:12.5px;color:var(--mut,#6A6B66)}.ds-stat b{font-size:22px;font-weight:500;letter-spacing:-.02em;line-height:1.2;font-variant-numeric:tabular-nums}.ds-stat[aria-pressed='true']{background:var(--sel,#1F2023);border-color:var(--sel,#1F2023);color:var(--sel-ink,#F4F4EF)}.ds-stat[aria-pressed='true'] small{color:inherit;opacity:.78}.ds-stat:focus-visible{outline:2px solid var(--focus,#1A1B1D);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Bento Board",
    "overview": "LeadFinder is a board of soft, rounded tiles on a warm grey ground. Each lead is a small card that carries only its name, a website-status pill, an ink strength meter and a Google button. Everything else lives one click deeper, in a bento of tiles that opens beside a narrowed list. At rest the board is calm and low in contrast. Charcoal ink does the structural work, and a single lemon yellow marks where the seller should act next.\n\nBoth themes share one geometry. Light mode puts clean white tiles with hairline borders on warm grey. Dark mode puts charcoal tiles on a near-black ground with warm off-white ink. Lemon looks the same in both themes. Selection is always inverted ink: charcoal on light, off-white on charcoal. Navigation has two layouts that use the same tokens: a 256px side rail tile, or a charcoal top bar shaped like a pill.\n\nMotion has one authored moment: a card opening into its profile. The grid collapses to a single column and the bento tiles stagger in. All other motion supports that moment: the reflow when a card is logged away, entrances, and the theme sweep. All of it turns off cleanly under reduced motion.",
    "keyCharacteristics": [
      "Warm grey ground with white (light) or charcoal (dark) tiles; hairline borders, no heavy chrome.",
      "Three nested radii: tiles 28px, cards 22px, and every control is a full pill or a circle.",
      "Lemon is a rare signal for what to do next; selection is inverted ink.",
      "Website status is a dot plus a word; an unverified status gets a diagonal hatch.",
      "Host Grotesk only, at medium weights, with tabular numbers wherever a count appears.",
      "GSAP Flip carries the card-to-profile opening; content stays visible without it."
    ],
    "rules": [
      {
        "name": "The Lemon Means Act Rule",
        "body": "Full-strength lemon appears only where the seller acts next or where the app is live: the primary button, the active nav item, the Google-profile row and the live dot. Cards on the board never carry lemon; their strength shows as ink bars only.",
        "section": "colors"
      },
      {
        "name": "The Inverted Ink Rule",
        "body": "A selected state always uses the ink colour as its fill and the ground colour as its text, in both themes. Never show selection with lemon or with a status colour.",
        "section": "colors"
      },
      {
        "name": "The Tabular Count Rule",
        "body": "Any number that can change (tab counts, nav counts, stats, table numerals) uses tabular figures, so the board doesn't jitter as counts update.",
        "section": "typography"
      },
      {
        "name": "The No Shouting Rule",
        "body": "No uppercase, no letter-spaced labels. Hierarchy comes from size and weight only.",
        "section": "typography"
      },
      {
        "name": "The Flat Until Touched Rule",
        "body": "Tiles and cards sit flat with a hairline at rest. A card lifts only on hover, and only floating layers carry Pop.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every control a full pill and every icon button a 40px circle; keep tiles at 28px and cards at 22px.",
      "Do show selection as Inverted Ink (selected / selected-ink) in both themes.",
      "Do write website status as dot + word, and hatch it when the status is unverified.",
      "Do keep cards sparse: name, one or two status pills, ink strength bars, the Google button.",
      "Do set every changing count in tabular figures.",
      "Do route new motion through the motion module so it respects reduced motion and the boot guard."
    ],
    "donts": [
      "Don't put lemon on board cards or use it for a selected state; it marks the next action, the active nav item and live state only.",
      "Don't set white text on lemon; use Lemon Ink.",
      "Don't convey status by colour alone; the word is always there.",
      "Don't give tiles or cards a resting shadow; Lift is for hover, Pop for floating layers.",
      "Don't add uppercase or letter-spaced labels above headings.",
      "Don't hide content behind animation; with no GSAP, changes just happen."
    ]
  }
}